# Korvo-1 board DTB and the onboard ES8389 codec.
CONFIG_BUILTIN_DTB_NAME="espressif/esp32s31_korvo1"
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ES8389=y

# SocketCAN / CTU CAN-FD controller support.
CONFIG_CAN=y
CONFIG_CAN_RAW=y
CONFIG_CAN_BCM=y
CONFIG_CAN_GW=y
CONFIG_CAN_CTUCANFD=y
CONFIG_CAN_CTUCANFD_PLATFORM=y

# Korvo-1 I2S0/ES8389 sound card and its AHB GDMA channels.
CONFIG_DMADEVICES=y
CONFIG_ESP32S31_AHB_GDMA=y
CONFIG_SND_SOC_ESP32S31_I2S=y
CONFIG_SND_SIMPLE_CARD=y

# V4L2 and vb2 live on microSD as modules to keep the NOR kernel small.
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_VIDEO_DEV=m
CONFIG_VIDEO_KORVO_CAMERA_HELPERS=m
CONFIG_VIDEOBUF2_CORE=m
CONFIG_VIDEOBUF2_V4L2=m
CONFIG_VIDEOBUF2_MEMOPS=m
CONFIG_VIDEOBUF2_VMALLOC=m

# Linux owns LCD timing/scanout; the reserved framebuffer survives handoff.
# CONFIG_FB_SIMPLE is not set
CONFIG_FB_ESP32S31=y
