#!/bin/sh
# SPDX-License-Identifier: MIT
case ${1:-start} in
  start)
    [ -e /dev/fb0 ] || exit 0
    pidof korvo-ui korvo-ui-extra lvgl-music-demo lvgl-music-demo-extra >/dev/null && exit 0
    /usr/bin/korvo-ui menu >/var/log/korvo-ui.log 2>&1 &
    ;;
  stop)
    killall korvo-ui korvo-ui-extra lvgl-music-demo lvgl-music-demo-extra 2>/dev/null || true
    for attempt in 1 2 3 4 5; do
      pidof korvo-ui korvo-ui-extra lvgl-music-demo lvgl-music-demo-extra >/dev/null || break
      sleep 1
    done
    ;;
  restart) "$0" stop; sleep 1; "$0" start;;
esac
exit 0
