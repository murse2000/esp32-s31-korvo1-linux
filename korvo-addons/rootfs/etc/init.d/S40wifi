#!/bin/sh
# SPDX-License-Identifier: MIT
# Wi-Fi reconnect watch.
#
# The old loop ran two wpa_cli processes every 10 seconds. On this 9 MiB board
# each fork/exec pulls code pages back from the SD card and provokes kswapd:
# stopping the loop dropped SD reads from 454 to 88 KB/s and kswapd scans from
# 256 to 57 per second. The steady-state path below forks nothing at all; the
# wpa_cli status probe and the profile check run once a minute.
IFACE=wlan0
CONF=/etc/wpa_supplicant.conf
PID=/run/korvo-wifi-watch.pid

alive() {
    [ -s "$1" ] || return 1
    read -r p < "$1" 2>/dev/null || return 1
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

watch_wifi()
{
    # A read-only image update must never replace a saved /etc profile.
    # Import the old removable partition profile only when /etc is empty.
    if ! grep -Eq '^[[:space:]]*network[[:space:]]*=' "$CONF" 2>/dev/null &&
       grep -Eq '^[[:space:]]*network[[:space:]]*=' /mnt/sd/wpa_supplicant.conf 2>/dev/null; then
        (umask 077; cp /mnt/sd/wpa_supplicant.conf "$CONF")
        chmod 600 "$CONF"
        logger -t wifi 'Imported saved profile from /mnt/sd'
    fi
    n=0
    while :; do
        # Profile presence is re-checked once a minute so that wifi-add is
        # still noticed without a restart.
        if [ $((n % 6)) -eq 0 ]; then
            if grep -Eq '^[[:space:]]*network[[:space:]]*=' "$CONF" 2>/dev/null; then
                have_profile=1
            else
                have_profile=0
            fi
        fi
        if [ "$have_profile" = 1 ] && [ -d /sys/class/net/$IFACE ]; then
            # Restart the supplicant only when its process is really gone.
            if ! alive /run/wpa_supplicant.$IFACE.pid; then
                rm -f /run/wpa_supplicant.$IFACE.pid
                ip link set "$IFACE" up
                wpa_supplicant -B -s -D nl80211 -i "$IFACE" -c "$CONF" -P /run/wpa_supplicant.$IFACE.pid
            fi
            if ! alive /run/wpa_cli.$IFACE.pid; then
                wpa_cli -B -i "$IFACE" -a /usr/sbin/wpa-dhcp-action -P /run/wpa_cli.$IFACE.pid
            fi
            # Repair a missed CONNECTED event or a dead DHCP client. This is
            # the only wpa_cli call left in the loop, every 30 seconds.
            if [ $((n % 3)) -eq 0 ]; then
                st=$(wpa_cli -i "$IFACE" status 2>/dev/null)
                case "$st" in
                    *wpa_state=COMPLETED*)
                        alive /run/udhcpc.$IFACE.pid || /usr/sbin/wpa-dhcp-action "$IFACE" CONNECTED
                        ;;
                esac
            fi
        fi
        n=$((n + 1))
        sleep 10
    done
}

case ${1:-start} in
    start)
        alive "$PID" && exit 0
        watch_wifi </dev/null >>/var/log/wifi-watch.log 2>&1 &
        echo $! > "$PID"
        echo 'Wi-Fi reconnect service started; use wifi-add to save a network.'
        ;;
    stop)
        for file in "$PID" /run/wpa_watch.$IFACE.pid /run/wpa_cli.$IFACE.pid /run/wpa_supplicant.$IFACE.pid /run/udhcpc.$IFACE.pid; do
            if alive "$file"; then kill "$(cat "$file")" 2>/dev/null || true; fi
            rm -f "$file"
        done
        wpa_cli -i "$IFACE" terminate >/dev/null 2>&1 || true
        ;;
    restart) "$0" stop; sleep 2; "$0" start;;
    status)
        wpa_cli -i "$IFACE" status
        ip -4 addr show dev "$IFACE"
        ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1;;
esac
exit 0
