diff --git a/linux/arch/riscv/boot/dts/espressif/esp32s31_korvo1.dts b/linux/arch/riscv/boot/dts/espressif/esp32s31_korvo1.dts
index 8bc8c02..5a1be91 100644
--- a/linux/arch/riscv/boot/dts/espressif/esp32s31_korvo1.dts
+++ b/linux/arch/riscv/boot/dts/espressif/esp32s31_korvo1.dts
@@ -137,3 +137,36 @@
 		touchscreen-size-y = <480>;
 	};
 };
+
+/* Read-only squashfs and persistent UBIFS overlay, relative to the shared
+ * flash MTD exported by Hart 0; these sizes match partitions-korvo1.csv. */
+&wifi {
+	flash {
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "rootfs";
+				reg = <0x0 0x007D0000>;
+				read-only;
+			};
+
+			partition@7d0000 {
+				label = "data";
+				reg = <0x007D0000 0x00160000>;
+			};
+		};
+	};
+};
+
+/* The schematic labels the codec's 8-bit I2C address as 0x20; Linux uses
+ * the corresponding 7-bit address 0x10. The ES8389 has no reset GPIO wired. */
+&i2c0 {
+	es8389: codec@10 {
+		compatible = "everest,es8389";
+		reg = <0x10>;
+		#sound-dai-cells = <0>;
+	};
+};
